  shorttitle = {Modeling {{Wording Effects Does Not Help}} in {{Recovering Uncontaminated Person Scores}}},
  author = {Nieto, María Dolores and Garrido, Luis Eduardo and Martínez-Molina, Agustín and Abad, Francisco José},
  date = {2021-06-02},
  journaltitle = {Frontiers in Psychology},
  shortjournal = {Front Psychol},
